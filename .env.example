# Environment variables for Flash Point Network (FP Network)
# Copy to `.env.local` and fill in real values when ready.
# The app runs without secrets using mocks/fallbacks.

# --- Site ---
NEXT_PUBLIC_SITE_NAME="Flash Point Network"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:43125"
# Optional server-side alias (same single origin). Production: https://fptn.com
# SITE_URL="http://127.0.0.1:43125"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Prefer anon JWT for @supabase/ssr; publishable key is also accepted as fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Admin image uploads write to public/uploads on the server disk (no Supabase Storage).
# Needed to run DDL migrations against the hosted project (pick one):
# SUPABASE_DB_PASSWORD="your-database-password"
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres"
# SUPABASE_ACCESS_TOKEN="sbp_..."  # Management API personal access token

# --- Email (Resend preferred; mock send if unset) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@fpnetwork.local"

# --- Optional Nodemailer SMTP fallback ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Optional AI provider env overrides (Settings UI is source of truth) ---
# AI_GOOGLE_API_KEY=""
# AI_OPENAI_API_KEY=""
# AI_XAI_API_KEY=""
# AI_ANTHROPIC_API_KEY=""
# AI_NVIDIA_API_KEY=""
# AI_PERPLEXITY_API_KEY=""
